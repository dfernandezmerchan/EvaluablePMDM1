<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:stretchColumns="*"
    android:padding="16dp">

    <!-- 1. PANTALLA DE LA CALCULADORA -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="#E0E0E0"
        android:gravity="end"
        android:padding="24dp"
        android:text="0"
        android:textColor="#000000"
        android:textSize="48sp" />

    <!-- 2. PRIMERA FILA: Botón de reset (C) y operaciones -->
    <TableRow>
        <Button android:id="@+id/btnReset" android:text="C" android:backgroundTint="#FF5252" />
        <Button android:id="@+id/btnDividir" android:text="/" />
        <Button android:id="@+id/btnMultiplicar" android:text="*" />
        <Button android:id="@+id/btnRestar" android:text="-" />
    </TableRow>

    <TableRow>
        <Button android:id="@+id/btn7" android:text="7" />
        <Button android:id="@+id/btn8" android:text="8" />
        <Button android:id="@+id/btn9" android:text="9" />
        <Button android:id="@+id/btnSumar" android:text="+" />
    </TableRow>

    <TableRow>
        <Button android:id="@+id/btn4" android:text="4" />
        <Button android:id="@+id/btn5" android:text="5" />
        <Button android:id="@+id/btn6" android:text="6" />
        <Button android:id="@+id/btnPunto" android:text="." />
    </TableRow>

    <TableRow>
        <Button android:id="@+id/btn1" android:text="1" />
        <Button android:id="@+id/btn2" android:text="2" />
        <Button android:id="@+id/btn3" android:text="3" />
        <Button android:id="@+id/btnIgual" android:text="=" android:backgroundTint="#4CAF50" />
    </TableRow>

    <TableRow>
        <Button
            android:id="@+id/btn0"
            android:text="0"
            android:layout_span="4" />
    </TableRow>





    <!-- Aquí irán las siguientes filas numéricas -->

</TableLayout>